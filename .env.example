# ==============================================================================
# ETL-Agent 平台 — 本地开发环境配置模板 (.env.example)
# ==============================================================================
# 安全声明：
# 1. 以下所有值均为仅用于本地开发与演示的占位符（LOCAL-DEV PLACEHOLDERS ONLY）。
# 2. 严禁提交真实密钥、私钥、生产密码或 `.env` 文件。
# 3. Vault 的 unseal 密钥与 root token 由 `scripts/dev/init-vault.ps1` 自动保存在
#    被 `.gitignore` 忽略的 `infra/vault/init/vault-init.json` 中，绝不入库。
# ==============================================================================

COMPOSE_PROJECT_NAME=etl-agent
APP_ENV=local
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 1. 宿主机回环端口绑定（compose.yaml 中严格仅绑定至 127.0.0.1）
# ------------------------------------------------------------------------------
FRONTEND_PORT=5174
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
VAULT_PORT=8200
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SEATUNNEL_REST_PORT=5801
DEMO_MYSQL_PORT=3306
DEMO_POSTGRES_PORT=5433
DORIS_FE_HTTP_PORT=8030
DORIS_FE_QUERY_PORT=9030
DORIS_BE_WEBSERVER_PORT=8040
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
TEMPO_PORT=3200
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# ------------------------------------------------------------------------------
# 2. 控制面 PostgreSQL 16（遵循 ADR-002 的三角色物理权限分离）
# ------------------------------------------------------------------------------
POSTGRES_DB=etl_control_plane
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev_only_pg_super_placeholder_not_for_prod

# 迁移与表拥有者角色（仅限 Alembic 迁移使用，应用运行时严禁使用）
PG_MIGRATOR_USER=etl_migrator
PG_MIGRATOR_PASSWORD=dev_only_migrator_placeholder_not_for_prod

# 应用与 Celery Worker 运行时角色（明确 NOBYPASSRLS，不拥有任何业务表）
PG_RUNTIME_USER=etl_runtime
PG_RUNTIME_PASSWORD=dev_only_runtime_placeholder_not_for_prod

# Outbox Dispatcher 最小权限角色（仅授予 outbox_events 与 outbox_deliveries 读写权）
PG_OUTBOX_USER=etl_outbox_dispatcher
PG_OUTBOX_PASSWORD=dev_only_outbox_placeholder_not_for_prod

DATABASE_MIGRATOR_URL=postgresql+psycopg://etl_migrator:dev_only_migrator_placeholder_not_for_prod@postgres:5432/etl_control_plane
DATABASE_RUNTIME_URL=postgresql+psycopg://etl_runtime:dev_only_runtime_placeholder_not_for_prod@postgres:5432/etl_control_plane
DATABASE_OUTBOX_URL=postgresql+psycopg://etl_outbox_dispatcher:dev_only_outbox_placeholder_not_for_prod@postgres:5432/etl_control_plane

# ------------------------------------------------------------------------------
# 3. Redis 7（Celery 消息代理 / 结果后端 / Capability 重放快路径缓存）
# ------------------------------------------------------------------------------
REDIS_PASSWORD=dev_only_redis_placeholder_not_for_prod
REDIS_URL=redis://:dev_only_redis_placeholder_not_for_prod@redis:6379/0
CELERY_BROKER_URL=redis://:dev_only_redis_placeholder_not_for_prod@redis:6379/1
CELERY_RESULT_BACKEND=redis://:dev_only_redis_placeholder_not_for_prod@redis:6379/2

# ------------------------------------------------------------------------------
# 4. HashiCorp Vault 1.18（遵循 ADR-001 默认采用持久化文件存储模式）
# ------------------------------------------------------------------------------
VAULT_ADDR=http://vault:8200
VAULT_HOST_ADDR=http://127.0.0.1:8200
VAULT_KV_MOUNT=secret
VAULT_TRANSIT_MOUNT=transit
VAULT_CAPABILITY_KEY_NAME=etl-agent-capability
VAULT_EVIDENCE_KEY_NAME=etl-agent-evidence
# 本地配置校验占位符；实际运行 token 由 init-vault.ps1 初始化后从本地文件加载
VAULT_TOKEN=dev_only_vault_token_placeholder_load_from_init
VAULT_DEV_ROOT_TOKEN_ID=dev_only_vault_ephemeral_profile_token
SECRET_PROVIDER_FALLBACK_KEY=dev_only_32byte_fernet_fallback_placeholder=

# ------------------------------------------------------------------------------
# 5. 认证、JWT 与 Mailpit（遵循 DEC-009 的本地邮件二次验证 / Email OTP）
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=dev_only_jwt_hmac_placeholder_change_in_deployment
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@etl-agent.local
EMAIL_OTP_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 6. MinIO 对象存储（多租户制品与受控上传文件存储）
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=etl_minio_admin
MINIO_ROOT_PASSWORD=dev_only_minio_placeholder_not_for_prod
MINIO_ENDPOINT=http://minio:9000
MINIO_DEFAULT_BUCKET=etl-agent-artifacts

# ------------------------------------------------------------------------------
# 7. Apache SeaTunnel 2.3.9（默认单节点 Zeta 引擎集群）
# ------------------------------------------------------------------------------
SEATUNNEL_ZETA_REST_URL=http://seatunnel-zeta:5801
SEATUNNEL_CLUSTER_NAME=etl-agent-zeta
SEATUNNEL_JVM_XMS=512m
SEATUNNEL_JVM_XMX=1536m

# ------------------------------------------------------------------------------
# 8. 数据面演示数据库（MySQL 8.0 CDC、PostgreSQL 16 Logical WAL、Doris 2.1.7）
# ------------------------------------------------------------------------------
DEMO_MYSQL_ROOT_PASSWORD=dev_only_demo_mysql_root_placeholder
DEMO_MYSQL_DATABASE=demo_ecommerce
DEMO_MYSQL_USER=demo_etl_reader
DEMO_MYSQL_PASSWORD=dev_only_demo_mysql_reader_placeholder

DEMO_POSTGRES_DB=demo_orders
DEMO_POSTGRES_USER=demo_pg_user
DEMO_POSTGRES_PASSWORD=dev_only_demo_pg_placeholder

DORIS_FE_USER=root
DORIS_FE_PASSWORD=
DORIS_DEFAULT_DATABASE=etl_warehouse
DORIS_FE_JVM_XMX=2048m
DORIS_BE_MEM_LIMIT=4G

# ------------------------------------------------------------------------------
# 9. LLM 模型提供方配置（严禁存放明文 API Key，通过 Vault Secret 引用）
# ------------------------------------------------------------------------------
LLM_PROVIDER_MODE=deterministic_mock
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_OPENAI_API_KEY_SECRET_REF=secret/data/llm/openai_api_key

# ------------------------------------------------------------------------------
# 10. 可观测性全栈（OTel Collector、Prometheus、Loki、Tempo、Grafana）
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=etl-agent-control-plane
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev_only_grafana_placeholder_not_for_prod

# ------------------------------------------------------------------------------
# 11. 前端配置（Vue 3 + Vite）
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 12. 可配置策略参数（遵循 DECISION_REGISTER §2 标记为 [CONFIGURABLE/TBD]）
# ------------------------------------------------------------------------------
POLICY_REJECT_RATE_THRESHOLD=0.20
POLICY_REJECT_RATE_MIN_VALIDATED_ROWS=100
POLICY_REJECT_RATE_WINDOW_SECONDS=60
POLICY_MAX_ERROR_ROWS_ABSOLUTE=50000
POLICY_MAX_REPAIR_ATTEMPTS=3
POLICY_MAX_SQL_EXECUTION_SECONDS=120
POLICY_METADATA_SAMPLE_RETENTION_DAYS=7
POLICY_EXECUTION_LOG_RETENTION_DAYS=30
