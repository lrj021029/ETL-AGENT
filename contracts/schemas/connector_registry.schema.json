{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etl-agent.local/contracts/schemas/connector_registry.schema.json",
  "title": "ConnectorCapabilityEntry",
  "description": "Versioned Connector Capability Matrix entry (Contract v1.0.0). Never mark unverified connectors as END_TO_END_VERIFIED.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "connector_id",
    "connector_name",
    "connector_version",
    "seatunnel_version",
    "roles",
    "auth_modes",
    "support_status",
    "capabilities",
    "publish_rollback_limits"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "connector_id": { "type": "string", "minLength": 1 },
    "connector_name": { "type": "string", "minLength": 1 },
    "connector_version": { "type": "string", "minLength": 1 },
    "seatunnel_version": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["SOURCE", "SINK", "TRANSFORM"] }
    },
    "auth_modes": { "type": "array", "items": { "type": "string" } },
    "support_status": {
      "type": "string",
      "enum": ["PLANNED", "CONFIGURED", "INTEGRATION_TESTED", "END_TO_END_VERIFIED", "UNSUPPORTED"]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata_probe",
        "full_load",
        "incremental",
        "cdc",
        "delete_events",
        "upsert",
        "checkpoint_restore",
        "schema_evolution",
        "quality_split_compatible"
      ],
      "properties": {
        "metadata_probe": { "type": "boolean" },
        "full_load": { "type": "boolean" },
        "incremental": { "type": "boolean" },
        "cdc": { "type": "boolean" },
        "delete_events": { "type": "boolean" },
        "upsert": { "type": "boolean" },
        "checkpoint_restore": { "type": "boolean" },
        "schema_evolution": { "type": "boolean" },
        "quality_split_compatible": { "type": "boolean" }
      }
    },
    "publish_rollback_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atomic_table_replace", "shadow_table_supported", "notes"],
      "properties": {
        "atomic_table_replace": { "type": "boolean" },
        "shadow_table_supported": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "test_evidence_ref": { "type": ["string", "null"] },
    "verified_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
