# =============================================================================
# 演示数据源 MySQL 8.0 配置文件 (infra/databases/mysql/my.cnf)
# 启用 Binlog ROW 模式与 GTID，支持 M7 批处理与 M8 SeaTunnel MySQL-CDC 实时同步
# =============================================================================

[mysqld]
server-id = 223344
log_bin = mysql-bin
binlog_format = ROW
binlog_row_image = FULL
gtid_mode = ON
enforce_gtid_consistency = ON
binlog_expire_logs_seconds = 604800

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
default_time_zone = '+00:00'

# 限制演示实例内存缓冲池占用，适配本机多容器并存运行
innodb_buffer_pool_size = 256M
max_connections = 150
